# Configuración de entorno para Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-secret-key-in-production

# Configuración de Base de Datos MySQL
# Formato: mysql+pymysql://usuario:password@host:puerto/nombre_db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/truckfleet_db

# Configuración adicional (reservado para futuras ampliaciones)
APP_NAME=TruckFleet
APP_VERSION=1.0.0
